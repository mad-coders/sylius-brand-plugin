<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">

    <class name="Madcoders\SyliusBrandPlugin\Model\BrandTranslation">
        <!-- Slugs are unique per locale, matching the (locale, slug) index. Two brands whose names
             slugify the same way are otherwise a 500 on save, and the generated slug makes that
             easy to hit: "Modern Wear" and "Modern-Wear" both become "modern-wear". -->
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">
                <value>locale</value>
                <value>slug</value>
            </option>
            <option name="errorPath">slug</option>
            <option name="message">madcoders_sylius_brand.brand.slug.unique</option>
            <option name="groups">madcoders_sylius_brand</option>
        </constraint>

        <property name="name">
            <constraint name="NotBlank">
                <option name="message">madcoders_sylius_brand.brand.name.not_blank</option>
                <option name="groups">madcoders_sylius_brand</option>
            </constraint>
            <constraint name="Length">
                <option name="max">255</option>
                <option name="maxMessage">madcoders_sylius_brand.brand.name.max_length</option>
                <option name="groups">madcoders_sylius_brand</option>
            </constraint>
        </property>

        <property name="slug">
            <constraint name="Length">
                <option name="max">255</option>
                <option name="maxMessage">madcoders_sylius_brand.brand.slug.max_length</option>
                <option name="groups">madcoders_sylius_brand</option>
            </constraint>
        </property>

        <property name="metaKeywords">
            <constraint name="Length">
                <option name="max">255</option>
                <option name="maxMessage">madcoders_sylius_brand.brand.meta_keywords.max_length</option>
                <option name="groups">madcoders_sylius_brand</option>
            </constraint>
        </property>

        <property name="metaDescription">
            <constraint name="Length">
                <option name="max">255</option>
                <option name="maxMessage">madcoders_sylius_brand.brand.meta_description.max_length</option>
                <option name="groups">madcoders_sylius_brand</option>
            </constraint>
        </property>
    </class>

</constraint-mapping>
