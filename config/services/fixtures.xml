<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="madcoders_sylius_brand.fixture.example_factory.brand"
                 class="Madcoders\SyliusBrandPlugin\Fixture\Factory\BrandExampleFactory"
                 public="true">
            <argument type="service" id="madcoders_sylius_brand.factory.brand" />
            <argument type="service" id="sylius.repository.locale" />
            <argument type="service" id="sylius.generator.slug" />
            <argument type="service" id="madcoders_sylius_brand.factory.brand_image" />
            <argument type="service" id="sylius.uploader.image" />
            <argument type="service" id="file_locator" />
        </service>

        <service id="madcoders_sylius_brand.fixture.brand"
                 class="Madcoders\SyliusBrandPlugin\Fixture\BrandFixture">
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="madcoders_sylius_brand.fixture.example_factory.brand" />

            <tag name="sylius_fixtures.fixture" />
        </service>
    </services>

</container>
