{# The brand badge on the product page.

   `product.brand is defined` rather than a plain property read: a host application that has not yet
   applied ProductTrait has a Product without a brand, and Twig's strict_variables (on in dev) turns
   that into a fatal instead of a missing badge. The `is defined` test is the one form that answers
   the question without throwing. #}
{% set product = product ?? hookable_metadata.context.product ?? null %}
{% set brand = product is not null and product.brand is defined ? product.brand : null %}

{% if madcoders_brands_enabled() and brand is not null and brand.enabled and brand.displayOnProductPage %}
    <div class="d-flex align-items-center gap-2 mb-2" {{ sylius_test_html_attribute('madcoders-product-brand') }}>
        {% if brand.logo is not null and brand.logo.path is not null %}
            <img src="{{ brand.logo.path|imagine_filter('madcoders_sylius_brand_logo_thumbnail') }}"
                 alt="{{ brand.name }}"
                 style="max-height: 32px; max-width: 96px;"
                 loading="lazy">
        {% endif %}

        <span class="text-muted small">{{ 'madcoders_sylius_brand.ui.brand'|trans }}:</span>
        {% include '@MadcodersSyliusBrandPlugin/shop/brand/_link.html.twig' with { brand: brand, class: 'fw-semibold' } only %}
    </div>
{% endif %}
