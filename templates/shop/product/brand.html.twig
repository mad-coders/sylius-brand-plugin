{# The brand of a product, as a hookable you can attach to any hook that has a product in context.

   Everything is driven by the hookable's `configuration`, so a host application never has to copy
   this file to change how it looks - see the README section "Putting brands on your own product
   grids".

     context_key  where the product lives in the hook context      (default: product)
     surface      which display toggle to respect; one of
                  homepage | product_page | product_tile |
                  brand_overview | any                             (default: product_tile)
     show_logo    render the brand logo before the name            (default: false)
     link         link to the brand page when it is reachable      (default: true)
     label        prefix with a translated "Brand:" label          (default: false)
     class        CSS classes for the wrapper                      (default: a muted small line)

   Renders nothing at all when the feature is off, the product has no brand, the brand is disabled,
   or the brand's toggle for this surface is off. `madcoders_brand_for()` applies all of that, and
   answers every row of a listing from one query. #}
{% set config = hookable_metadata.configuration|default({}) %}
{% set context_key = config.context_key|default('product') %}

{% set product = attribute(_context, context_key)|default(hookable_metadata.context[context_key]|default(null)) %}
{% set brand = madcoders_brand_for(product, config.surface|default('product_tile')) %}

{% if brand is not null %}
    {% set show_logo = config.show_logo|default(false) %}
    {% set logo = show_logo ? brand.logo : null %}

    <div class="{{ config.class|default('d-flex align-items-center gap-2 text-muted small') }}"
         {{ sylius_test_html_attribute('madcoders-product-brand', brand.code) }}>
        {% if logo is not null and logo.path is not null %}
            <img src="{{ logo.path|imagine_filter('madcoders_sylius_brand_logo_thumbnail') }}"
                 alt="{{ brand.name }}"
                 style="max-height: 32px; max-width: 96px;"
                 loading="lazy">
        {% endif %}

        {% if config.label|default(false) %}
            <span>{{ 'madcoders_sylius_brand.ui.brand'|trans }}:</span>
        {% endif %}

        {% if config.link|default(true) %}
            {% include '@MadcodersSyliusBrandPlugin/shop/brand/_link.html.twig' with {
                brand: brand,
                class: config.link_class|default('fw-semibold text-reset'),
            } only %}
        {% else %}
            <span class="{{ config.link_class|default('fw-semibold') }}">{{ brand.name }}</span>
        {% endif %}
    </div>
{% endif %}
